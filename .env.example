# Server Environment Configuration
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB connection string)
MONGO_URI=mongodb://localhost:27017/collabroom

# JWT Secrets (use high-entropy secrets in production)
JWT_SECRET=collabroom_super_secure_jwt_access_secret_2026_min32chars
JWT_REFRESH_SECRET=collabroom_super_secure_jwt_refresh_secret_2026_min32chars

# Encryption at rest key (must be exactly 32 bytes for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Storage Driver ('local' or 's3')
STORAGE_DRIVER=local
MAX_FILE_SIZE_MB=50

# WebRTC STUN & TURN
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Room Capacity & Limits
MAX_PARTICIPANTS=8
